<Window x:Class="CharacterCardManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:CharacterCardManager.Helpers"
        Title="Tavern Character Card Manager v1.0"
        Icon="app.ico"
        Width="1440" Height="880"
        MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextMainBrush}">

    <Window.Resources>
        <helpers:ThumbnailConverter x:Key="ThumbConverter"/>
        <helpers:HexToBrushConverter x:Key="HexToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Folder + Sync Actions -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Open Folder..." Style="{StaticResource AccentButtonStyle}"
                            Click="OpenFolder_Click"/>

                    <Border Grid.Column="2" Background="{StaticResource BgFieldBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="10,5">
                        <TextBlock x:Name="TxtFolderPath" Text="No folder selected"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <Button Grid.Column="4" Content="Rescan" Style="{StaticResource DarkButtonStyle}"
                            Click="Rescan_Click"/>

                    <Button Grid.Column="6" x:Name="BtnCancelSync" Content="Cancel Sync"
                            Style="{StaticResource DangerButtonStyle}" Visibility="Collapsed"
                            Click="CancelSync_Click"/>

                    <Button Grid.Column="8" x:Name="BtnBrowseBotbooru" Content="Browse Botbooru"
                            Style="{StaticResource VioletButtonStyle}"
                            Click="BrowseBotbooru_Click"/>

                    <Button Grid.Column="10" x:Name="BtnBotbooruLogin" Content="Botbooru Login"
                            Style="{StaticResource DarkButtonStyle}"
                            Click="BotbooruLogin_Click"/>
                </Grid>

                <!-- Row 2: Search + Quick Filters -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox x:Name="TxtSearch"
                                 TextChanged="SearchOrFilter_Changed"
                                 ToolTip="Search name, creator, tags, description, filename, or #ID. Prefix a tag with - to exclude (e.g. -anime)"/>
                        <TextBlock Text="Search name, creator, description, #ID, or exact tag:name / -tag:name..."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ComboBox Grid.Column="2" x:Name="CmbQuickFilter" SelectionChanged="SearchOrFilter_Changed"
                              SelectedIndex="0">
                        <ComboBoxItem Content="All Cards"/>
                        <ComboBoxItem Content="Missing 'original' (Non-OC / Copyright?)"/>
                        <ComboBoxItem Content="Original Only ('original')"/>
                        <ComboBoxItem Content="Has Lorebook"/>
                        <ComboBoxItem Content="V3 Cards Only"/>
                        <ComboBoxItem Content="Has Botbooru ID"/>
                        <ComboBoxItem Content="Not Synced (Botbooru)"/>
                        <ComboBoxItem Content="Synced Only"/>
                    </ComboBox>

                    <Button Grid.Column="4" Content="Clear Filters" Style="{StaticResource DarkButtonStyle}"
                            Click="ClearFilters_Click"/>

                    <Button Grid.Column="6" x:Name="BtnTagBrowser" Content="Tag Browser"
                            Style="{StaticResource VioletButtonStyle}"
                            Click="ToggleTagBrowser_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Split View -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColTagBrowser" Width="0"/>
                <ColumnDefinition Width="400" MinWidth="260" MaxWidth="650"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Col 0: Botbooru-style Tag Browser Drawer -->
            <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ComboBox Grid.Row="0" x:Name="CmbTagCategory" SelectedIndex="0"
                              SelectionChanged="TagBrowserFilter_Changed">
                        <ComboBoxItem Content="All Categories"/>
                        <ComboBoxItem Content="Copyright"/>
                        <ComboBoxItem Content="Characters"/>
                        <ComboBoxItem Content="Writer"/>
                        <ComboBoxItem Content="Artist"/>
                        <ComboBoxItem Content="Scenarios"/>
                        <ComboBoxItem Content="Settings"/>
                        <ComboBoxItem Content="Activities"/>
                        <ComboBoxItem Content="General"/>
                        <ComboBoxItem Content="Meta"/>
                        <ComboBoxItem Content="Language"/>
                        <ComboBoxItem Content="Auto"/>
                        <ComboBoxItem Content="Uncategorized"/>
                    </ComboBox>

                    <Grid Grid.Row="2">
                        <TextBox x:Name="TxtTagFilter" Padding="8,5" FontSize="12"
                                 TextChanged="TagBrowserFilter_Changed"/>
                        <TextBlock Text="Filter tags..." Foreground="{StaticResource TextMutedBrush}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtTagFilter}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ListBox Grid.Row="4" x:Name="LstTagBrowser"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{StaticResource BgCardBrush}"
                                                    CornerRadius="4" Padding="6,4">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#252538"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding ShortCategory}"
                                               Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               Foreground="{StaticResource TextMainBrush}"
                                               FontSize="11.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Cursor="Hand"
                                               Tag="{Binding Name}"
                                               MouseLeftButtonUp="TagBrowserInclude_Click"
                                               ToolTip="{Binding Name}"/>

                                    <TextBlock Grid.Column="2" Text="{Binding Count}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" VerticalAlignment="Center" Margin="4,0"/>

                                    <Button Grid.Column="4" Content="+" Padding="5,1" FontSize="11"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Tag="{Binding Name}" ToolTip="Include tag in search"
                                            Click="TagBrowserIncludeBtn_Click"/>

                                    <Button Grid.Column="6" Content="-" Padding="6,1" FontSize="11"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Tag="{Binding Name}" ToolTip="Exclude tag from search (-tag)"
                                            Click="TagBrowserExcludeBtn_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Col 1: Card List -->
            <Border Grid.Column="1" Background="{StaticResource BgDeepBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                            Padding="10,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtListVisibleCount" Text="0 cards"
                                       Foreground="{StaticResource AccentPosBrush}"
                                       FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtListSelectedCount" Text=""
                                       Foreground="{StaticResource AccentSeedBrush}"
                                       FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="LstCards"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionMode="Extended"
                         SelectionChanged="LstCards_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Padding="6">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Sync All (Tags, Gallery &amp; Links)" Click="SyncSelectedAll_Click"/>
                            <MenuItem Header="Sync Tag Categories from Botbooru" Click="SyncSelected_Click"/>
                            <MenuItem Header="Open on Botbooru" Click="OpenSelectedBotbooru_Click"/>
                            <MenuItem Header="Open File Location" Click="OpenFileLocation_Click"/>
                            <MenuItem Header="Rename File..." Click="RenameCard_Click"/>
                            <Separator/>
                            <MenuItem Header="Move Selected to Folder..." Click="MoveSelected_Click"/>
                            <MenuItem Header="Delete Selected File(s)..." Foreground="{StaticResource AccentNegBrush}" Click="DeleteSelected_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="CardBorder"
                                                Background="{StaticResource BgCardBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8"
                                                Cursor="Hand">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#252538"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#23293A"/>
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentPosBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="54" Height="70" CornerRadius="4"
                                        Background="{StaticResource BgFieldBrush}" ClipToBounds="True">
                                    <Image Source="{Binding FilePath, Converter={StaticResource ThumbConverter}, ConverterParameter=110}"
                                           Stretch="UniformToFill"/>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   FontWeight="SemiBold" FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" Background="#2463CAB7"
                                                BorderBrush="#6063CAB7" BorderThickness="1"
                                                CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsBotbooruSynced, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="✓ Synced" Foreground="{StaticResource AccentPosBrush}"
                                                       FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding BotbooruDisplay}"
                                                   Foreground="{StaticResource AccentSeedBrush}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </Grid>

                                    <TextBlock Text="{Binding MetaLine}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11.5" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding Tagline}"
                                               Foreground="#9A9AB8"
                                               FontSize="11" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tagline}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource BgPanelBrush}" Cursor="SizeWE"/>

            <!-- Right Pane: Inspector & Editor -->
            <Grid Grid.Column="3" Background="{StaticResource BgDeepBrush}">
                <TextBlock x:Name="TxtEmptySelection"
                           Text="Select a character card on the left to view or edit its metadata."
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <ScrollViewer x:Name="EditorScroll" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <!-- Header Card -->
                        <Border Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="96" Height="124" CornerRadius="6"
                                        Background="{StaticResource BgFieldBrush}" ClipToBounds="True"
                                        Cursor="Hand" ToolTip="Click to view full-size image"
                                        MouseLeftButtonUp="ImgPreview_Click">
                                    <Image x:Name="ImgPreview" Stretch="UniformToFill"/>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtHeaderName" FontSize="20" FontWeight="Bold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtHeaderTagline" FontSize="12.5" FontStyle="Italic"
                                               Foreground="#B4B4D0" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock x:Name="TxtHeaderMeta" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12.5"/>
                                        <TextBlock x:Name="TxtBotbooruLink" Margin="10,0,0,0"
                                                   Foreground="{StaticResource AccentSeedBrush}"
                                                   FontSize="12.5" FontWeight="SemiBold"
                                                   Cursor="Hand" TextDecorations="Underline"
                                                   MouseLeftButtonUp="TxtBotbooruLink_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtHeaderFile" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                               Cursor="Hand" ToolTip="Click to copy file path to clipboard"
                                               MouseLeftButtonUp="TxtHeaderFile_Click"/>

                                    <StackPanel x:Name="PanelWritingStyle" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtWritingStyle" Foreground="{StaticResource TextMainBrush}"
                                                   FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Border Width="140" Height="7" CornerRadius="3.5"
                                                Background="{StaticResource BgFieldBrush}" VerticalAlignment="Center" ClipToBounds="True">
                                            <Border x:Name="BarWritingStyle" HorizontalAlignment="Left" CornerRadius="3.5" Width="0"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button x:Name="BtnHeaderSync" Content="Sync" Style="{StaticResource VioletButtonStyle}"
                                            Margin="0,0,8,0" Visibility="Collapsed" Click="HeaderSync_Click"/>
                                    <Button Content="Rename..." Style="{StaticResource DarkButtonStyle}"
                                            Margin="0,0,8,0" Click="RenameCard_Click"/>
                                    <Button x:Name="BtnRevert" Content="Revert" Style="{StaticResource DarkButtonStyle}"
                                            Margin="0,0,8,0" Click="Revert_Click"/>
                                    <Button x:Name="BtnSave" Content="Save to PNG" Style="{StaticResource AccentButtonStyle}"
                                            Click="Save_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Categorized Tags Card -->
                        <Border Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="TAGS" FontWeight="Bold" FontSize="12.5"
                                               Foreground="{StaticResource AccentPosBrush}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" Text="(Click tag to filter, right-click to exclude)"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>

                                    <TextBox Grid.Column="2" x:Name="TxtNewTag" Padding="8,4" FontSize="12"
                                             KeyDown="TxtNewTag_KeyDown"/>
                                    <Button Grid.Column="4" Content="+ Add Tag" Style="{StaticResource DarkButtonStyle}"
                                            Padding="10,4" Click="AddTag_Click"/>
                                </Grid>

                                <ItemsControl x:Name="ItemsTagGroups">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding CategoryHeader}"
                                                           Foreground="{Binding CategoryColorHex, Converter={StaticResource HexToBrush}}"
                                                           FontSize="11.5" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <ItemsControl ItemsSource="{Binding Tags}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource BgCardBrush}"
                                                                    BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                                    BorderThickness="1" CornerRadius="4"
                                                                    Margin="0,0,6,5" Padding="7,3">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                                               FontSize="11.5" Cursor="Hand"
                                                                               MouseLeftButtonUp="TagChip_LeftClick"
                                                                               MouseRightButtonUp="TagChip_RightClick"/>
                                                                    <TextBlock Text=" ×" Foreground="{StaticResource TextMutedBrush}"
                                                                               FontSize="11.5" FontWeight="Bold"
                                                                               Cursor="Hand" Margin="4,0,0,0"
                                                                               Tag="{Binding Name}"
                                                                               MouseLeftButtonUp="RemoveTag_Click"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Tabbed Field Editor -->
                        <Border Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14">
                            <TabControl>
                                <TabItem Header="Profile">
                                    <StackPanel Margin="0,10,0,0">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Name" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                                <TextBox x:Name="EdName" TextChanged="EditorField_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Creator" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                                <TextBox x:Name="EdCreator" TextChanged="EditorField_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Version" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                                <TextBox x:Name="EdVersion" TextChanged="EditorField_Changed"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Tagline" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                                <TextBox x:Name="EdTagline" TextChanged="EditorField_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Nickname" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                                <TextBox x:Name="EdNickname" TextChanged="EditorField_Changed"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Description" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EdDescription" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="160" MaxHeight="340" VerticalScrollBarVisibility="Auto"
                                                 Margin="0,0,0,10" TextChanged="EditorField_Changed"/>

                                        <TextBlock Text="Personality" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EdPersonality" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="90" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                                 Margin="0,0,0,10" TextChanged="EditorField_Changed"/>

                                        <TextBlock Text="Scenario" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EdScenario" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="90" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                                 TextChanged="EditorField_Changed"/>
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="Greetings">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="First Message" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EdFirstMessage" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="180" MaxHeight="340" VerticalScrollBarVisibility="Auto"
                                                 Margin="0,0,0,12" TextChanged="EditorField_Changed"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="TxtAltGreetLabel"
                                                       Text="Alternate Greetings (0)"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11.5" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="+ Add Greeting" Style="{StaticResource DarkButtonStyle}"
                                                    Padding="10,4" Click="AddAltGreeting_Click"/>
                                            <Button Grid.Column="3" Content="Remove Selected" Style="{StaticResource DangerButtonStyle}"
                                                    Padding="10,4" Click="RemoveAltGreeting_Click"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <ListBox Grid.Column="0" x:Name="LstAltGreetings"
                                                     Background="{StaticResource BgFieldBrush}"
                                                     Foreground="{StaticResource TextMainBrush}"
                                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                                     MinHeight="150" MaxHeight="260"
                                                     SelectionChanged="LstAltGreetings_SelectionChanged"/>

                                            <TextBox Grid.Column="2" x:Name="EdAltGreeting"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     MinHeight="150" MaxHeight="260"
                                                     VerticalScrollBarVisibility="Auto"
                                                     TextChanged="EdAltGreeting_TextChanged"/>
                                        </Grid>
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="Prompts &amp; Notes">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="System Prompt" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EdSystemPrompt" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="90" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                                 Margin="0,0,0,10" TextChanged="EditorField_Changed"/>

                                        <TextBlock Text="Post-History Instructions" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EdPostHistory" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="90" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                                 Margin="0,0,0,10" TextChanged="EditorField_Changed"/>

                                        <TextBlock Text="Message Example" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EdMesExample" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="110" MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                                 Margin="0,0,0,10" TextChanged="EditorField_Changed"/>

                                        <TextBlock Text="Creator Notes" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                        <TextBox x:Name="EdCreatorNotes" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="90" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                                 TextChanged="EditorField_Changed"/>
                                    </StackPanel>
                                </TabItem>

                                <TabItem x:Name="TabGallery" Header="Gallery">
                                    <StackPanel Margin="0,10,0,0">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" x:Name="BtnLoadGallery"
                                                    Content="Load Botbooru Gallery"
                                                    Style="{StaticResource VioletButtonStyle}"
                                                    Click="LoadGallery_Click"/>

                                            <Button Grid.Column="2" Content="Replace Image from Local PNG..."
                                                    Style="{StaticResource DarkButtonStyle}"
                                                    Click="ReplaceLocalImage_Click"/>

                                            <TextBlock Grid.Column="3" x:Name="TxtGalleryInfo"
                                                       Text="Pick a gallery image to embed this card's metadata into it."
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>

                                        <ItemsControl x:Name="ItemsGallery">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource BgCardBrush}"
                                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                                            BorderThickness="1" CornerRadius="6"
                                                            Padding="8" Margin="0,0,10,10" Width="196">
                                                        <StackPanel>
                                                            <Border Height="220" CornerRadius="4"
                                                                    Background="{StaticResource BgFieldBrush}"
                                                                    ClipToBounds="True" Margin="0,0,0,8"
                                                                    Cursor="Hand" ToolTip="Click to view full-size image"
                                                                    Tag="{Binding MainViewUrl}"
                                                                    MouseLeftButtonUp="GalleryImage_Click">
                                                                <Image Source="{Binding PreviewUrl}" Stretch="Uniform"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Label}"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       FontSize="11" HorizontalAlignment="Center"
                                                                       Margin="0,0,0,6"/>
                                                            <Button Content="Use as Card Image"
                                                                    Style="{StaticResource AccentButtonStyle}"
                                                                    Tag="{Binding DownloadUrl}"
                                                                    Click="UseGalleryImage_Click"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </TabItem>

                                <TabItem x:Name="TabLinks" Header="Links &amp; Forks">
                                    <StackPanel Margin="0,10,0,0">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" x:Name="BtnLoadLinks"
                                                    Content="Load Links &amp; Forks"
                                                    Style="{StaticResource VioletButtonStyle}"
                                                    Click="LoadLinks_Click"/>
                                            <TextBlock Grid.Column="1" x:Name="TxtLinksStatus"
                                                       Text="Check if this card is a fork, master, or has sibling cards on Botbooru."
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                                                       TextWrapping="Wrap"/>
                                        </Grid>

                                        <Border x:Name="BannerForkStatus" Visibility="Collapsed"
                                                Background="#22ED6464" BorderBrush="{StaticResource AccentNegBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                            <TextBlock x:Name="TxtForkBanner" Foreground="{StaticResource AccentNegBrush}"
                                                       FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                                        </Border>

                                        <ItemsControl x:Name="ItemsLinks">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource BgCardBrush}"
                                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                                            BorderThickness="1" CornerRadius="6"
                                                            Padding="10,8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" Background="{StaticResource BgFieldBrush}"
                                                                    BorderBrush="{Binding RelationColorHex, Converter={StaticResource HexToBrush}}"
                                                                    BorderThickness="1" CornerRadius="4"
                                                                    Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Relation}"
                                                                           Foreground="{Binding RelationColorHex, Converter={StaticResource HexToBrush}}"
                                                                           FontSize="11" FontWeight="Bold"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13"/>
                                                                <TextBlock Text="{Binding LocalStatusText}"
                                                                           Foreground="{Binding LocalStatusColorHex, Converter={StaticResource HexToBrush}}"
                                                                           FontSize="11" Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <Button Grid.Column="2" Content="Jump to Card"
                                                                    Style="{StaticResource AccentButtonStyle}"
                                                                    Padding="10,4"
                                                                    Visibility="{Binding IsInFolder, Converter={StaticResource BoolToVis}}"
                                                                    Tag="{Binding Id}"
                                                                    Click="JumpToLinkedCard_Click"/>

                                                            <Button Grid.Column="2" Content="Download to Folder"
                                                                    Style="{StaticResource VioletButtonStyle}"
                                                                    Padding="10,4"
                                                                    Visibility="{Binding NotInFolder, Converter={StaticResource BoolToVis}}"
                                                                    Tag="{Binding}"
                                                                    Click="DownloadLinkedCard_Click"/>

                                                            <Button Grid.Column="4" Content="Open on Botbooru"
                                                                    Style="{StaticResource DarkButtonStyle}"
                                                                    Padding="10,4"
                                                                    Tag="{Binding Id}"
                                                                    Click="OpenLinkedBotbooru_Click"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </TabItem>

                                <TabItem x:Name="TabAskAi" Header="Ask AI">
                                    <StackPanel Margin="0,10,0,0">
                                        <!-- Endpoint / Model / API Key -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="OpenAI-Compatible Endpoint (Oobabooga / LM Studio / Ollama)"
                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TxtLlmEndpoint" Text="http://127.0.0.1:5000"
                                                         Padding="8,5" FontSize="12" LostFocus="LlmSettings_LostFocus"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Model (optional)"
                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TxtLlmModel" Padding="8,5" FontSize="12"
                                                         LostFocus="LlmSettings_LostFocus"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="API Key (optional)"
                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TxtLlmApiKey" Padding="8,5" FontSize="12"
                                                         LostFocus="LlmSettings_LostFocus"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Quick Prompts -->
                                        <WrapPanel Margin="0,0,0,10">
                                            <Button Content="Quick Audit" Style="{StaticResource VioletButtonStyle}"
                                                    Padding="9,4" Margin="0,0,6,4"
                                                    Tag="Give a quick structured audit of this card: 1) World, time period &amp; setting, 2) Number of characters &amp; roles, 3) Actual character vs disguised scenario/narrator, 4) Relationship with {{user}}, 5) Any red flags or hidden prompt rules."
                                                    Click="AiQuickPrompt_Click"/>
                                            <Button Content="World &amp; Setting" Style="{StaticResource DarkButtonStyle}"
                                                    Padding="9,4" Margin="0,0,6,4"
                                                    Tag="What is the story environment? Describe the world, time period, and setting."
                                                    Click="AiQuickPrompt_Click"/>
                                            <Button Content="Character Count" Style="{StaticResource DarkButtonStyle}"
                                                    Padding="9,4" Margin="0,0,6,4"
                                                    Tag="How many characters does this card contain? List each character and their role."
                                                    Click="AiQuickPrompt_Click"/>
                                            <Button Content="Narrator vs Character" Style="{StaticResource DarkButtonStyle}"
                                                    Padding="9,4" Margin="0,0,6,4"
                                                    Tag="Is this card an actual character or a scenario/RPG narrator disguised as a character? Explain briefly."
                                                    Click="AiQuickPrompt_Click"/>
                                            <Button Content="Relation to User" Style="{StaticResource DarkButtonStyle}"
                                                    Padding="9,4" Margin="0,0,6,4"
                                                    Tag="What is the character's relationship with {{user}}, and what dynamic/POV does the opening set up?"
                                                    Click="AiQuickPrompt_Click"/>
                                            <Button Content="Check Red Flags" Style="{StaticResource DarkButtonStyle}"
                                                    Padding="9,4" Margin="0,0,6,4"
                                                    Tag="Check for any hidden fetishes, extreme themes, weird system prompt rules, or unexpected instructions in this card."
                                                    Click="AiQuickPrompt_Click"/>
                                            <Button Content="Summarize Card" Style="{StaticResource DarkButtonStyle}"
                                                    Padding="9,4" Margin="0,0,6,4"
                                                    Tag="Summarize this character, setting, and scenario in 3 concise bullet points."
                                                    Click="AiQuickPrompt_Click"/>
                                            <Button Content="Suggest Tagline" Style="{StaticResource DarkButtonStyle}"
                                                    Padding="9,4" Margin="0,0,6,4"
                                                    Tag="Write a punchy 1-sentence tagline summarizing this character card."
                                                    Click="AiQuickPrompt_Click"/>
                                            <Button Content="Suggest Missing Tags" Style="{StaticResource DarkButtonStyle}"
                                                    Padding="9,4" Margin="0,0,6,4"
                                                    Tag="Based on the card text, suggest 5-10 relevant tags that are missing from the current tag list."
                                                    Click="AiQuickPrompt_Click"/>
                                            <Button Content="Clear Chat" Style="{StaticResource DangerButtonStyle}"
                                                    Padding="9,4" Margin="0,0,0,4"
                                                    Click="ClearAiChat_Click"/>
                                        </WrapPanel>

                                        <!-- Chat History -->
                                        <Border Background="{StaticResource BgFieldBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="6"
                                                MinHeight="240" MaxHeight="400" Margin="0,0,0,10">
                                            <ScrollViewer x:Name="ScrollAiChat" VerticalScrollBarVisibility="Auto" Padding="10">
                                                <ItemsControl x:Name="ItemsAiChat">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource BgCardBrush}"
                                                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                                                    BorderThickness="1" CornerRadius="6"
                                                                    Padding="10,7" Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding SenderLabel}"
                                                                               Foreground="{Binding SenderColorHex, Converter={StaticResource HexToBrush}}"
                                                                               FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                                                    <TextBox Text="{Binding Content, Mode=OneWay}"
                                                                             IsReadOnly="True" BorderThickness="0"
                                                                             Background="Transparent" Padding="0"
                                                                             TextWrapping="Wrap" FontSize="12.5"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Prompt Input -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0" x:Name="TxtAiPrompt"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     MinHeight="46" MaxHeight="110"
                                                     VerticalScrollBarVisibility="Auto"
                                                     KeyDown="TxtAiPrompt_KeyDown"/>

                                            <Button Grid.Column="2" x:Name="BtnAskAi" Content="Send"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Padding="18,10" VerticalAlignment="Bottom"
                                                    Click="AskAiSend_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                <TextBlock Grid.Column="1" x:Name="TxtCount" Text="0 cards" Foreground="{StaticResource AccentPosBrush}" FontSize="12" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
