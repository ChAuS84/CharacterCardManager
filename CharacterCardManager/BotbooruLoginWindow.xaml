<Window x:Class="CharacterCardManager.BotbooruLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Botbooru Login"
        Width="960" Height="740"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextMainBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Sign in to Botbooru below (needed for NSFW posts), then click 'Save Session &amp; Close'."
                           Foreground="{StaticResource TextMainBrush}"
                           VerticalAlignment="Center" FontSize="12.5"/>

                <Button Grid.Column="1" Content="Clear Session" Style="{StaticResource DangerButtonStyle}"
                        Click="ClearSession_Click"/>

                <Button Grid.Column="3" Content="Save Session &amp; Close" Style="{StaticResource AccentButtonStyle}"
                        Click="SaveSession_Click"/>
            </Grid>
        </Border>

        <!-- Embedded Browser -->
        <wv2:WebView2 Grid.Row="1" x:Name="WebView"/>

        <!-- Manual Cookie Fallback -->
        <Border Grid.Row="2" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Or paste Cookie header:" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" FontSize="11.5"/>
                <TextBox Grid.Column="2" x:Name="TxtManualCookie" Padding="8,4" FontSize="11.5"/>
                <Button Grid.Column="4" Content="Use Pasted Cookie" Style="{StaticResource DarkButtonStyle}"
                        Padding="10,4" Click="UseManualCookie_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
